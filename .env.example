# ============================================================
# IntelliProcure AI – Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES FOR YOUR DEPLOYMENT.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT.
# ============================================================

# ── Application Configuration ────────────────────────────────
APP_NAME=IntelliProcure AI
ENVIRONMENT=development
DEBUG=True

# ── Database ──────────────────────────────────────────────────
# Default local dev uses SQLite. For Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/intelliprocure
DATABASE_URL=sqlite:///./intelliprocure.db

# ── Security & JWT ────────────────────────────────────────────
# Generate strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=YOUR_GENERATE_SECRET_KEY_MIN_32_CHARS_CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI / LLM Providers (Optional) ────────────────────────────
# If omitted, application operates with local rule-based intelligence engine
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# ── ERP Integration (Optional) ────────────────────────────────
# Provider options: MOCK, ORACLE_CLOUD, SAP_S4HANA, DYNAMICS_365
ERP_PROVIDER=MOCK
ORACLE_ERP_BASE_URL=https://your-oracle-domain.fa.us2.oraclecloud.com
ORACLE_ERP_USERNAME=your_oracle_username
ORACLE_ERP_PASSWORD=your_oracle_password
SAP_HOST=https://your-sap-host.com
SAP_CLIENT=100
SAP_API_KEY=your_sap_api_key
DYNAMICS_RESOURCE_URL=https://your-dynamics-org.operations.dynamics.com
DYNAMICS_TENANT_ID=your_tenant_id
DYNAMICS_CLIENT_ID=your_client_id
DYNAMICS_CLIENT_SECRET=your_client_secret

# ── SSO / OAuth 2.0 (Optional) ────────────────────────────────
OKTA_DOMAIN=https://your-domain.okta.com
OKTA_CLIENT_ID=your_okta_client_id
OKTA_CLIENT_SECRET=your_okta_client_secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Document OCR (Optional) ──────────────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-azure-ocr.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_key_here
