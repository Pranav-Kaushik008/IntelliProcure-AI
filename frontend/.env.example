# ============================================================
#  IntelliProcure AI – Frontend Environment Variables Template
#  File: frontend/.env.example
# ============================================================

# ── App ─────────────────────────────────────────────────────
VITE_APP_NAME=IntelliProcure AI
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# ── Backend API ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/api/v1

# ── ENTERPRISE SSO – Okta ────────────────────────────────────
VITE_OKTA_DOMAIN=your-tenant.us.auth0.com
VITE_OKTA_CLIENT_ID=your_okta_client_id_placeholder

# ── ENTERPRISE SSO – Google Workspace ───────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash