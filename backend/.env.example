# ============================================================
#  IntelliProcure AI – Backend Environment Variables
#  File: backend/.env
#  Copy this file to backend/.env and fill in your values.
#  NEVER commit .env to source control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=IntelliProcure AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ── Database ─────────────────────────────────────────────────
# For local dev, SQLite is used automatically if DATABASE_URL is blank.
# For production, set to a full PostgreSQL DSN.
DATABASE_URL=postgresql://user:password@localhost:5432/intelliprocure

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=your_secret_key_here_generate_with_openssl
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
ALLOWED_HEADERS=*

# ── Redis (optional – used for caching & WebSocket pub/sub) ──
REDIS_URL=redis://localhost:6379/0

# ────────────────────────────────────────────────────────────
#  SSO / OAUTH 2.0 – Okta
#  Setup: Okta Developer Console → Applications → your app → General tab
# ────────────────────────────────────────────────────────────
OKTA_DOMAIN=your-tenant.us.auth0.com                    # e.g. yourorg.okta.com
OKTA_CLIENT_ID=your_okta_client_id                      # Same as VITE_OKTA_CLIENT_ID
OKTA_CLIENT_SECRET=your_okta_client_secret              # From Okta Application → Client Credentials

# ────────────────────────────────────────────────────────────
#  SSO / OAUTH 2.0 – Google Workspace
#  Setup: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com                # Same as VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=your_google_client_secret           # From Google Cloud Console → OAuth 2.0 Client Secrets

# ────────────────────────────────────────────────────────────
#  AI / ML SERVICES
# ────────────────────────────────────────────────────────────
# OpenAI (used for AI Copilot chat, invoice OCR, contract parsing)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_placeholder                 # sk-...

# OpenAI model to use (gpt-5.4-mini is recommended for procurement intelligence)
OPENAI_MODEL=gpt-5.4-mini

# Anthropic Claude (alternative AI backend – optional)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=              # sk-ant-...

# ────────────────────────────────────────────────────────────
#  DOCUMENT PROCESSING / OCR
# ────────────────────────────────────────────────────────────
# Azure Document Intelligence (for invoice OCR, contract parsing)
# Setup: Azure Portal → Document Intelligence (Form Recognizer)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=   # https://yourname.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=        # 32-char API key from Azure

# ────────────────────────────────────────────────────────────
#  EMAIL SERVICE
# ────────────────────────────────────────────────────────────
# Used for approval notifications, password reset, PO/invoice emails
# Option A: SendGrid
SENDGRID_API_KEY=               # SG.xxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=IntelliProcure AI

# Option B: SMTP (fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# ────────────────────────────────────────────────────────────
#  FILE STORAGE
# ────────────────────────────────────────────────────────────
# AWS S3 (for contract PDFs, invoice attachments, audit exports)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=intelliprocure-documents

# Azure Blob Storage (alternative)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=intelliprocure-docs

# ────────────────────────────────────────────────────────────
#  ERP INTEGRATIONS (optional)
# ────────────────────────────────────────────────────────────
# SAP Business One / S4HANA
SAP_BASE_URL=
SAP_CLIENT=
SAP_USER=
SAP_PASSWORD=

# Oracle ERP Cloud REST API
ORACLE_ERP_BASE_URL=            # https://yourinstance.fa.ocs.oraclecloud.com
ORACLE_ERP_USERNAME=
ORACLE_ERP_PASSWORD=

# Microsoft Dynamics 365 (via OAuth2 + Dataverse API)
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
DYNAMICS_CLIENT_SECRET=
DYNAMICS_ENVIRONMENT_URL=       # https://yourorg.crm.dynamics.com

# ────────────────────────────────────────────────────────────
#  MONITORING & OBSERVABILITY
# ────────────────────────────────────────────────────────────
# Sentry (error tracking)
# Get from: https://sentry.io
SENTRY_DSN=                     # https://xxx@xxx.ingest.sentry.io/xxx

# ────────────────────────────────────────────────────────────
#  PAYMENT / BANKING (for supplier payments module)
# ────────────────────────────────────────────────────────────
# Stripe (if integrated for payment processing)
STRIPE_SECRET_KEY=              # sk_live_...
STRIPE_WEBHOOK_SECRET=          # whsec_...
